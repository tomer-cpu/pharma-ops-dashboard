# Copy to .env next to where the service runs. Never commit the real file.

# ── Source ──────────────────────────────────────────────────────────────
# local = folder or UNC path (service runs on Windows with access to the share)
# smb   = connect to the Windows server over SMB3 from any OS (pip install smbprotocol)
CSV_SYNC_SOURCE_TYPE=local
CSV_SYNC_SOURCE_PATH=\\fileserver\exports\ops_metrics
CSV_SYNC_FILE_PATTERN=*.csv

# Only for CSV_SYNC_SOURCE_TYPE=smb (CSV_SYNC_SOURCE_PATH is then the folder inside the share)
# CSV_SYNC_SMB_SERVER=fileserver.corp.local
# CSV_SYNC_SMB_SHARE=exports
# CSV_SYNC_SMB_USERNAME=CORP\svc-csv-sync
# CSV_SYNC_SMB_PASSWORD=
# CSV_SYNC_SMB_REQUIRE_ENCRYPTION=true

# ── Change detection ────────────────────────────────────────────────────
CSV_SYNC_STATE_DB=C:\ProgramData\csv_sync\state.db
CSV_SYNC_FILE_SETTLE_SECONDS=30
CSV_SYNC_POLL_INTERVAL=300

# ── Validation ──────────────────────────────────────────────────────────
CSV_SYNC_ALLOWED_SITES=New Jersey,Basel,Dublin,Singapore,Hyderabad
CSV_SYNC_ALLOWED_PRODUCT_LINES=Oncology,Cardiovascular,Immunology,CNS,Respiratory
CSV_SYNC_DATE_FORMATS=%Y-%m-%d,%d/%m/%Y,%d.%m.%Y
CSV_SYNC_MAX_INVALID_RATIO=0.10

# ── Base44 ──────────────────────────────────────────────────────────────
# URL of the deployed ingest-ops-metrics backend function (must be https://)
BASE44_INGEST_URL=https://<your-app>.base44.app/functions/ingest-ops-metrics
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set the same value as CSV_SYNC_SIGNING_SECRET in the Base44 app secrets
BASE44_SIGNING_SECRET=
# Optional: corporate CA bundle if outbound TLS is inspected by a proxy
# BASE44_CA_BUNDLE=C:\certs\corp-ca.pem
CSV_SYNC_BATCH_SIZE=200
